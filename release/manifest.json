{
  "manifest_version": 3,
  "name": "Clip AI Paste",
  "version": "0.1.1",
  "description": "Clipboard text -> AI -> paste in one shortcut.",
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "commands": {
    "run-clip-ai-paste": {
      "suggested_key": {
        "default": "Ctrl+B"
      },
      "description": "Run Clip AI Paste"
    }
  },
  "action": {
    "default_title": "Clip AI Paste",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}