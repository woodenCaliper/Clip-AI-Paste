{
  "manifest_version": 3,
  "name": "Clip AI Paste",
  "version": "1.0.0",
  "description": "Read clipboard text, process it with AI (rewrite, translate, summarize), and paste the result—all with one shortcut.",
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "commands": {
    "run-clip-ai-paste": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Run Clip AI Paste"
    }
  },
  "action": {
    "default_title": "Clip AI Paste",
    "default_icon": {
      "16": "icon128.png",
      "32": "icon128.png"
    }
  },
  "icons": {
    "16": "icon128.png",
    "32": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  }
}
